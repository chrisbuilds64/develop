  "skills": {
    "vorpruefung": {
      "stage": "30-vorpruefung",
      "$comment": "Photos against positions, calculation plausibility, the draft for gaps and contradictions; writes pruefbericht.md and moves the file to the reviewer."
    },
    "anschreiben": {
      "stage": "50-versand",
      "$comment": "Drafts the cover letter from approved text modules (_bausteine/) and the file; a person sends."
    },
    "belegpruefung": {
      "stage": "60-versendet",
      "$comment": "Invoice against report and calculation; writes belegpruefung.md."
    },
    "ask": {
      "stage": "*",
      "$comment": "A free question about the file."
    },
    "fotohinweis": {
      "stage": "20-besichtigung",
      "$comment": "Looks at the photos and notes while the assessor is still at the car: missing views, what to clarify, likely hidden damage from similar cases. Writes fotohinweise.md and, for the on-site view, fotohinweise.json ({round, summary, photograph[], clarify[], notice[]}, each item {id, text, why, view?, photo?}). Called again, it reads vorort.json (what the assessor ticked and answered) and starts the next round."
    },
    "muster": {
      "stage": "*",
      "$comment": "Across all files: duplicates, repeats, deviations. Writes signals to _signale/."
    },
    "ergebnis": {
      "stage": "20-besichtigung",
      "$comment": "Reads the dictation and the calculation, writes the result as data, every value with the words it came from."
    }
  },
