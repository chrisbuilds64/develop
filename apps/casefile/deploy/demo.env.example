# /opt/casefile/demo.env — the public demo. Fictional worlds only; never point this at a real pipeline.
CASEFILE_DEMO_WORLDS=/opt/casefile/demo/worlds
CASEFILE_SESSIONS=/opt/casefile/demo/sessions
CASEFILE_WEB=/opt/casefile/web-dist
CASEFILE_DEFAULT_WORLD=claims
# a long random string; cookies are signed with it. `openssl rand -hex 32`
CASEFILE_SECRET=change-me
