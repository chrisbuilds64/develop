{
  "$comment": "A claims file as configuration (ADR-015). Invented demo domain; every name fictional. Five stations: report, inspection, your check, settlement, closed. 10-meldung: the claims handler orders the assessment; in the demo the order opens a case in the visitor's e-report sandbox (handover create).",
  "name": "Schadenakte",
  "lang": "de",
  "configVersion": "1",
  "stages": [
    {
      "folder": "10-meldung",
      "key": "report",
      "group": "ideas",
      "turn": "role:approver",
      "actions": [
        {
          "id": "order_assessment",
          "label": "order_assessment",
          "to": "20-besichtigung",
          "payload": [
            "date"
          ],
          "handover": {
            "target": "egutachten",
            "mode": "create",
            "label": "KH",
            "stage": "10-auftrag",
            "number": "source",
            "slug": "source",
            "external_id": "GA-{year}-0{seq}",
            "link": "gutachten_auftrag",
            "meta": {
              "title": "{source.title}",
              "subtitle": "{source.subtitle}",
              "client": "Nordlicht Versicherung",
              "schaden_nr": "{source.external_id}"
            },
            "files": {
              "meldung.md": "auftrag.md",
              "fotos-*.jpg": ""
            },
            "by": "innendienst",
            "entry": {
              "title": "Auftrag von {source.external_id}",
              "text": "Gutachtenauftrag {ref} zum Schaden {source.external_id} über das GDV Schadennetz eingegangen. Schadenmeldung und Fotos des Versicherers liegen bei. Besichtigung einplanen."
            }
          }
        }
      ]
    },
    {
      "folder": "20-besichtigung",
      "key": "inspection",
      "group": "others",
      "turn": "role:assessor",
      "actions": [
        {
          "id": "deliver_report",
          "label": "deliver_report",
          "to": "25-abgleich",
          "requires": [
            "gutachten.pdf|gutachten.md",
            "shape:image"
          ],
          "entry_status": "info",
          "run": "reconcile"
        }
      ]
    },
    {
      "folder": "25-abgleich",
      "key": "inspection",
      "group": "claude",
      "turn": "claude"
    },
    {
      "folder": "30-pruefung",
      "key": "check",
      "group": "you",
      "turn": "role:approver",
      "actions": [
        {
          "id": "approve_settlement",
          "label": "approve_settlement",
          "to": "40-regulierung",
          "requires": [
            "gutachten.pdf|gutachten.md",
            "rechnung.pdf"
          ],
          "payload": [
            "amount"
          ],
          "entry_status": "approved",
          "seal": true
        },
        {
          "id": "ask_assessor",
          "label": "ask_assessor",
          "payload": [
            "note"
          ],
          "entry_status": "open",
          "actor": "role:approver"
        }
      ],
      "auto": [
        {
          "on_file": "rechnung.pdf",
          "skill": "reconcile",
          "note": "Rechnung ist da."
        }
      ]
    },
    {
      "folder": "40-regulierung",
      "key": "settlement",
      "group": "others",
      "turn": "role:settlement",
      "actions": [
        {
          "id": "paid",
          "label": "paid",
          "to": "60-abgeschlossen",
          "entry_status": "info"
        }
      ]
    },
    {
      "folder": "60-abgeschlossen",
      "key": "closed",
      "group": "out"
    }
  ]
}
