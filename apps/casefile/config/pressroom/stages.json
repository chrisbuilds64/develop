{
  "$comment": "The content pipeline as configuration (ADR-015). Folder = status; key = the station on the line; turn = whose move; actions = the one button per stage, with what it needs. Words live in vocabulary.json under 'actions' and 'stages'. From 2026-11-12 every move is a step through the core, as in every other application: working an idea out moves the case into the draft and gives it its number (`number`), and the helper's own two moves — interpreted, draft ready — are its steps (casefile.cli.step), never a folder it moves itself. The text gate asks its questions in a protocol (protocols/text.json): the fixed ones, plus the ones this one piece raises.",
  "name": "PressRoom",
  "lang": "en",
  "configVersion": "1",
  "stages": [
    {
      "folder": "00-archive",
      "key": "archive",
      "group": "archive"
    },
    {
      "folder": "05-operational-observations",
      "key": "idea",
      "group": "ideas",
      "turn": "role:author",
      "actions": [
        {
          "id": "work_out",
          "label": "work_out",
          "run": "interpret",
          "entry_status": "info",
          "to": "15-interpretation",
          "number": [
            "{seq:03}"
          ]
        }
      ]
    },
    {
      "folder": "10-ideas",
      "key": "idea",
      "group": "ideas",
      "turn": "role:author",
      "actions": [
        {
          "id": "work_out",
          "label": "work_out",
          "run": "interpret",
          "entry_status": "info",
          "to": "15-interpretation",
          "number": [
            "{seq:03}"
          ]
        }
      ]
    },
    {
      "folder": "15-interpretation",
      "key": "draft",
      "group": "claude",
      "turn": "claude",
      "actions": [
        {
          "id": "interpreted",
          "label": "interpreted",
          "to": "20-produce",
          "requires": [
            "interpretation.md"
          ],
          "entry_status": "info"
        },
        {
          "id": "draft_ready",
          "label": "draft_ready",
          "$comment": "A piece that came with its material has no interpretation: its checks done, it goes to the person from here.",
          "to": "30-review-human",
          "requires": [
            "primary"
          ],
          "entry_status": "info"
        }
      ]
    },
    {
      "folder": "20-produce",
      "key": "draft",
      "group": "claude",
      "turn": "claude",
      "actions": [
        {
          "id": "draft_ready",
          "label": "draft_ready",
          "to": "30-review-human",
          "requires": [
            "primary"
          ],
          "entry_status": "info"
        }
      ]
    },
    {
      "folder": "30-review-human",
      "key": "review",
      "group": "you",
      "turn": "role:approver",
      "actions": [
        {
          "id": "approve_to_visual",
          "label": "approve_to_visual",
          "to": "40-asset-generation",
          "requires": [
            "primary",
            "protocol:text"
          ],
          "four_eyes": false,
          "entry_status": "approved",
          "seal": true,
          "protocol_on_demand": true
        },
        {
          "id": "rework",
          "label": "rework",
          "run": "interpret",
          "payload": [
            "note"
          ],
          "entry_status": "open"
        }
      ]
    },
    {
      "folder": "40-asset-generation",
      "key": "visual",
      "group": "others",
      "turn": "role:visual",
      "actions": [
        {
          "id": "approve_visual",
          "label": "approve_visual",
          "to": "50-ready-to-publish",
          "requires": [
            "shape:image"
          ],
          "actor": "role:approver",
          "entry_status": "approved",
          "seal": true
        }
      ]
    },
    {
      "folder": "50-ready-to-publish",
      "key": "date",
      "group": "date",
      "turn": "role:approver",
      "actions": [
        {
          "id": "schedule",
          "label": "schedule",
          "to": "55-scheduled",
          "payload": [
            "date"
          ]
        }
      ]
    },
    {
      "folder": "55-scheduled",
      "key": "date",
      "group": "planned",
      "turn": "role:approver",
      "actions": [
        {
          "id": "published",
          "label": "published",
          "to": "60-published",
          "payload": [
            "url"
          ],
          "seal": true
        }
      ]
    },
    {
      "folder": "60-published",
      "key": "out",
      "group": "out"
    },
    {
      "folder": "61-field-observation",
      "key": "out",
      "group": "out"
    },
    {
      "folder": "65-canonical-review",
      "key": "out",
      "group": "out"
    },
    {
      "folder": "66-reviewed",
      "key": "out",
      "group": "out"
    },
    {
      "folder": "70-reference-frames",
      "key": "out",
      "group": "out"
    }
  ]
}
