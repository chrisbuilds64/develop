{
  "$comment": "A change to our own software as a case (REQ-002, ADR-027). The way of a change from CONTRIBUTING.md, stage by stage: the product owner confirms the task, a developer (a person or an agent) builds it on a branch and records the pull request, the checks are recorded, the product owner merges (four eyes: never the author of the pull request), the release is a tag, and each stage (ENTW, TEST, PROD) is accepted by the product owner. Every record is a file in the case; nothing is claimed that is not linked. From 2026-11-09 the developer's moves can be a helper's (ADR-028): confirming the task orders the build, the pull request orders the checks, the merge and each acceptance order the release; the deploy reports back to the case.",
  "name": "Shipyard",
  "lang": "en",
  "configVersion": "1",
  "stages": [
    {
      "folder": "10-task",
      "key": "task",
      "group": "you",
      "turn": "role:product_owner",
      "actions": [
        {
          "id": "accept_task",
          "label": "accept_task",
          "to": "20-build",
          "requires": [
            "task.md",
            "criteria"
          ],
          "entry_status": "approved",
          "run": "shipyard-build"
        },
        {
          "id": "draft_task",
          "label": "draft_task",
          "run": "shipyard-task",
          "produces": [
            "task.md",
            "criteria"
          ]
        }
      ]
    },
    {
      "folder": "20-build",
      "key": "build",
      "group": "you",
      "turn": "role:developer",
      "actions": [
        {
          "id": "open_pr",
          "label": "open_pr",
          "to": "30-checks",
          "requires": [
            "pr.md"
          ],
          "entry_status": "info",
          "run": "shipyard-checks"
        }
      ]
    },
    {
      "folder": "30-checks",
      "key": "checks",
      "group": "you",
      "turn": "role:developer",
      "actions": [
        {
          "id": "checks_green",
          "label": "checks_green",
          "to": "40-approval",
          "requires": [
            "checks.md"
          ],
          "entry_status": "info"
        },
        {
          "id": "checks_red",
          "label": "checks_red",
          "to": "20-build",
          "run": "shipyard-build",
          "payload": [
            "note"
          ],
          "requires": [
            "checks.md"
          ],
          "entry_status": "info"
        },
        {
          "id": "retry_checks",
          "label": "retry_checks",
          "actor": "role:product_owner",
          "run": "shipyard-checks",
          "entry_status": "info"
        }
      ]
    },
    {
      "folder": "40-approval",
      "key": "approval",
      "group": "you",
      "turn": "role:product_owner",
      "actions": [
        {
          "id": "merge",
          "label": "merge",
          "to": "50-release",
          "requires": [
            "pr.md",
            "checks.md",
            "protocol:merge"
          ],
          "four_eyes": true,
          "seal": true,
          "entry_status": "approved",
          "run": "shipyard-release"
        },
        {
          "id": "send_back",
          "label": "send_back",
          "to": "20-build",
          "payload": [
            "note"
          ],
          "entry_status": "info",
          "run": "shipyard-build"
        }
      ]
    },
    {
      "folder": "50-release",
      "key": "release",
      "group": "you",
      "turn": "role:developer",
      "actions": [
        {
          "id": "deploy_entw",
          "label": "deploy_entw",
          "to": "60-entw",
          "requires": [
            "release.md"
          ],
          "entry_status": "info"
        },
        {
          "id": "retry_release",
          "label": "retry_release",
          "actor": "role:product_owner",
          "run": "shipyard-release",
          "entry_status": "info"
        }
      ],
      "deploys": "entw"
    },
    {
      "folder": "60-entw",
      "key": "entw",
      "group": "you",
      "turn": "role:product_owner",
      "actions": [
        {
          "id": "approve_test",
          "label": "approve_test",
          "to": "70-test",
          "requires": [
            "release.md",
            "protocol:entw"
          ],
          "seal": true,
          "entry_status": "approved",
          "run": "shipyard-release"
        },
        {
          "id": "entw_failed",
          "label": "entw_failed",
          "to": "20-build",
          "when": [
            "failed:entw"
          ]
        }
      ]
    },
    {
      "folder": "70-test",
      "key": "test",
      "group": "you",
      "turn": "role:product_owner",
      "actions": [
        {
          "id": "approve_prod",
          "label": "approve_prod",
          "to": "80-prod",
          "requires": [
            "test.md",
            "protocol:test"
          ],
          "seal": true,
          "entry_status": "approved",
          "run": "shipyard-release"
        },
        {
          "id": "deploy_refused",
          "label": "deploy_refused",
          "to": "60-entw",
          "actor": "role:developer",
          "payload": [
            "note"
          ],
          "entry_status": "info"
        },
        {
          "id": "test_failed",
          "label": "test_failed",
          "to": "20-build",
          "when": [
            "failed:test"
          ]
        }
      ],
      "deploys": "test"
    },
    {
      "folder": "80-prod",
      "key": "prod",
      "group": "you",
      "turn": "role:developer",
      "actions": [
        {
          "id": "close",
          "label": "close",
          "to": "90-closed",
          "requires": [
            "prod.md"
          ],
          "entry_status": "info"
        },
        {
          "id": "deploy_refused",
          "label": "deploy_refused",
          "to": "70-test",
          "actor": "role:developer",
          "payload": [
            "note"
          ],
          "entry_status": "info"
        }
      ],
      "deploys": "prod"
    },
    {
      "folder": "90-closed",
      "key": "closed",
      "group": "out",
      "turn": null,
      "actions": []
    }
  ]
}
