{
  "id": "worklist",
  "name": "Work list",
  "version": "0.2.0",
  "description": "Open items from a Context Loop todo.json — what is due, who holds it, what is blocked. Actions run todo.py.",
  "reader": "reader.py",
  "needs": [
    "worklist",
    "tools"
  ],
  "maturity": "running",
  "actions": [
    {
      "id": "add",
      "label": "worklist.add",
      "tool": "tools",
      "command": "todo.py",
      "args": [
        "add",
        "{title}",
        "--cluster",
        "{cluster}",
        "--prio",
        "{prio}",
        "--due",
        "{due}",
        "--source-kind",
        "decision",
        "--source-ref",
        "Cockpit"
      ],
      "data": "worklist",
      "field": [
        {
          "name": "title",
          "label": "field.title",
          "required": true
        },
        {
          "name": "cluster",
          "label": "field.cluster",
          "type": "select",
          "required": true,
          "options_from": "todo.json:lov.clusters"
        },
        {
          "name": "prio",
          "label": "field.prio",
          "type": "select",
          "options_from": "todo.json:lov.priorities"
        },
        {
          "name": "due",
          "label": "field.due",
          "type": "date"
        }
      ]
    },
    {
      "id": "done",
      "label": "worklist.done",
      "tool": "tools",
      "command": "todo.py",
      "args": [
        "done",
        "{id}"
      ],
      "data": "worklist",
      "field": [
        {
          "name": "id",
          "label": "field.id",
          "required": true
        }
      ]
    },
    {
      "id": "move",
      "label": "worklist.move",
      "tool": "tools",
      "command": "todo.py",
      "args": [
        "set",
        "{id}",
        "--status",
        "{status}"
      ],
      "data": "worklist",
      "field": [
        {
          "name": "id",
          "label": "field.id",
          "required": true
        },
        {
          "name": "status",
          "label": "field.status",
          "type": "select",
          "required": true,
          "options_from": "todo.json:lov.statuses"
        }
      ]
    }
  ],
  "icon": "check",
  "accent": "#2fa36b"
}
