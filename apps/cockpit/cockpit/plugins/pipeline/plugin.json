{
  "id": "pipeline",
  "name": "PressRoom · Content pipeline",
  "version": "0.10.1",
  "description": "Folders are stages, subfolders are pieces; series/<LABEL>/ holds a series head that clamps its pieces and carries their order. The page starts with the ideas: anyone enters one (idea_new.py writes the seed container into 10-ideas) and starts its interpretation with one button (run_request.py --skill interpret). Below: the board by stage, every piece with its files and images; series and calendar folded. Actions: move a container, append to its review, put a versioned asset into it — nothing is ever overwritten. runner.py on a person's machine executes ordered runs in a headless agent session.",
  "reader": "reader.py",
  "needs": [
    "pipeline"
  ],
  "maturity": "running",
  "actions": [
    {
      "id": "idea",
      "label": "pipeline.idea",
      "tool": "plugin",
      "command": "idea_new.py",
      "args": [
        "--label",
        "{label}",
        "--title",
        "{title}",
        "--by",
        "{user}",
        "--series",
        "{series}",
        "--put",
        "script.md",
        "{a_script_md.name}",
        "{a_script_md}",
        "--put",
        "teleprompter.txt",
        "{a_teleprompter_txt.name}",
        "{a_teleprompter_txt}",
        "--put",
        "show-notes.txt",
        "{a_show_notes_txt.name}",
        "{a_show_notes_txt}",
        "--put",
        "linkedin-post.txt",
        "{a_linkedin_post_txt.name}",
        "{a_linkedin_post_txt}",
        "--put",
        "first-comment.txt",
        "{a_first_comment_txt.name}",
        "{a_first_comment_txt}",
        "--put",
        "edit-instructions.txt",
        "{a_edit_instructions_txt.name}",
        "{a_edit_instructions_txt}",
        "--put",
        "reel-hooks.txt",
        "{a_reel_hooks_txt.name}",
        "{a_reel_hooks_txt}",
        "--put",
        "visual-brief.md",
        "{a_visual_brief_md.name}",
        "{a_visual_brief_md}",
        "--put",
        "substack.md",
        "{a_substack_md.name}",
        "{a_substack_md}",
        "--put",
        "substack.html",
        "{a_substack_html.name}",
        "{a_substack_html}"
      ],
      "data": "pipeline",
      "scope": "module",
      "stdin": "text",
      "field": [
        {
          "name": "label",
          "label": "field.label",
          "type": "select",
          "required": true,
          "options_from": "meta.schema.json:label"
        },
        {
          "name": "title",
          "label": "field.title",
          "required": true,
          "placeholder": "the working title"
        },
        {
          "name": "series",
          "label": "field.series_opt",
          "placeholder": "SIM, GH, RT — only an existing series"
        },
        {
          "name": "text",
          "label": "field.idea_text",
          "type": "textarea",
          "placeholder": "the idea in a few lines — or the finished text, pasted"
        },
        {
          "name": "a_script_md",
          "label": "script.md",
          "type": "file",
          "accept": [
            "md"
          ]
        },
        {
          "name": "a_teleprompter_txt",
          "label": "teleprompter.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_show_notes_txt",
          "label": "show-notes.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_linkedin_post_txt",
          "label": "linkedin-post.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_first_comment_txt",
          "label": "first-comment.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_edit_instructions_txt",
          "label": "edit-instructions.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_reel_hooks_txt",
          "label": "reel-hooks.txt",
          "type": "file",
          "accept": [
            "txt"
          ]
        },
        {
          "name": "a_visual_brief_md",
          "label": "visual-brief.md",
          "type": "file",
          "accept": [
            "md"
          ]
        },
        {
          "name": "a_substack_md",
          "label": "substack.md",
          "type": "file",
          "accept": [
            "md"
          ]
        },
        {
          "name": "a_substack_html",
          "label": "substack.html",
          "type": "file",
          "accept": [
            "html"
          ]
        }
      ]
    },
    {
      "id": "interpret",
      "label": "pipeline.interpret",
      "tool": "plugin",
      "command": "run_request.py",
      "args": [
        "{ref}",
        "--skill",
        "interpret",
        "--by",
        "{user}",
        "--role",
        "{role}",
        "--note",
        "{note}"
      ],
      "data": "pipeline",
      "scope": "document",
      "stages": [
        "10-ideas"
      ],
      "field": [
        {
          "name": "note",
          "label": "field.run_note",
          "type": "textarea"
        }
      ]
    },
    {
      "id": "ask",
      "label": "pipeline.ask",
      "tool": "plugin",
      "command": "ask_agent.py",
      "args": [
        "{ref}",
        "--by",
        "{user}",
        "--role",
        "{role}"
      ],
      "data": "pipeline",
      "scope": "document",
      "stdin": "text",
      "field": [
        {
          "name": "text",
          "label": "field.text",
          "type": "textarea",
          "required": true,
          "placeholder": "what the agent should do — the first line becomes the heading"
        }
      ]
    },
    {
      "id": "move",
      "label": "pipeline.move",
      "tool": "plugin",
      "command": "move.py",
      "args": [
        "{container}",
        "{stage}"
      ],
      "data": "pipeline",
      "field": [
        {
          "name": "container",
          "label": "field.container",
          "required": true,
          "placeholder": "the container's folder name"
        },
        {
          "name": "stage",
          "label": "field.stage",
          "type": "select",
          "required": true,
          "options": [
            "00-archive",
            "05-operational-observations",
            "10-ideas",
            "15-interpretation",
            "20-produce",
            "30-review-human",
            "40-asset-generation",
            "50-ready-to-publish",
            "55-scheduled",
            "60-published",
            "61-field-observation",
            "65-canonical-review",
            "66-reviewed",
            "70-reference-frames"
          ]
        }
      ]
    },
    {
      "id": "schedule",
      "label": "pipeline.schedule",
      "tool": "plugin",
      "command": "schedule.py",
      "data": "pipeline",
      "scope": "document",
      "args": [
        "{ref}",
        "{date}"
      ],
      "field": [
        {
          "name": "date",
          "label": "field.date",
          "type": "date",
          "required": true
        }
      ]
    },
    {
      "id": "review_append",
      "label": "pipeline.review_append",
      "tool": "plugin",
      "command": "review_append.py",
      "args": [
        "{ref}",
        "--by",
        "{user}",
        "--title",
        "{title}",
        "--status",
        "{status}",
        "--for",
        "{for}",
        "--resolves",
        "{resolves}"
      ],
      "data": "pipeline",
      "scope": "document",
      "stdin": "text",
      "field": [
        {
          "name": "title",
          "label": "field.title",
          "required": true,
          "placeholder": "one line: what this is about"
        },
        {
          "name": "status",
          "label": "field.status",
          "type": "select",
          "required": true,
          "options_from": "review.schema.json:status"
        },
        {
          "name": "for",
          "label": "field.for",
          "type": "select",
          "options_from": "review.schema.json:for"
        },
        {
          "name": "resolves",
          "label": "field.resolves",
          "placeholder": "REV-002"
        },
        {
          "name": "text",
          "label": "field.text",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "id": "upload",
      "label": "pipeline.upload",
      "tool": "plugin",
      "command": "asset_put.py",
      "args": [
        "{ref}",
        "{kind}",
        "{file}",
        "--name",
        "{file.name}",
        "--by",
        "{user}"
      ],
      "data": "pipeline",
      "scope": "document",
      "field": [
        {
          "name": "kind",
          "label": "field.kind",
          "type": "select",
          "required": true,
          "options_from": "artifacts.json:kinds"
        },
        {
          "name": "file",
          "label": "field.file",
          "type": "file",
          "required": true,
          "accept": [
            "png",
            "jpg",
            "jpeg",
            "mp4",
            "mov",
            "md",
            "txt",
            "html"
          ]
        }
      ]
    },
    {
      "id": "verify",
      "label": "pipeline.verify",
      "tool": "plugin",
      "command": "verify.py",
      "args": [
        "{ref}"
      ],
      "data": "pipeline",
      "scope": "document"
    },
    {
      "id": "skill",
      "label": "pipeline.skill",
      "tool": "plugin",
      "command": "run_request.py",
      "args": [
        "{ref}",
        "--skill",
        "{skill}",
        "--by",
        "{user}",
        "--role",
        "{role}",
        "--note",
        "{note}"
      ],
      "data": "pipeline",
      "scope": "document",
      "field": [
        {
          "name": "skill",
          "label": "field.skill",
          "type": "select",
          "required": true,
          "options_from": "run.schema.json:skill"
        },
        {
          "name": "note",
          "label": "field.run_note",
          "type": "textarea"
        }
      ]
    }
  ],
  "icon": "film",
  "accent": "#3b82f6"
}
